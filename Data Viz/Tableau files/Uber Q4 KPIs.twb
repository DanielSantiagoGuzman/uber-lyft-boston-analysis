      <aliases enabled='yes' />
      <column caption='Date' datatype='date' name='[Calculation_2401785155948545]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([datetime])' />
      </column>
      <column caption='Stars Customer' datatype='string' name='[Calculation_2401785156866051]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Customer Rating] &lt;= 1 THEN &quot;0 stars&quot;&#10;ELSEIF [Customer Rating] &lt;= 2 THEN &apos;1 stars&apos;&#10;ELSEIF [Customer Rating] &lt;= 3 THEN &apos;2 stars&apos;&#10;ELSEIF [Customer Rating] &lt;= 4 THEN &apos;3 stars&apos;&#10;ELSEIF [Customer Rating] &lt;= 5 THEN &apos;4 stars&apos;&#10;ELSE &apos;5 stars&apos;&#10;END' />
      </column>
      <column caption='Stars Driver' datatype='string' name='[Calculation_2401785158471684]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Driver Ratings] &lt;= 1 THEN &quot;0 stars&quot;&#10;ELSEIF [Driver Ratings] &lt;= 2 THEN &apos;1 stars&apos;&#10;ELSEIF [Driver Ratings] &lt;= 3 THEN &apos;2 stars&apos;&#10;ELSEIF [Driver Ratings] &lt;= 4 THEN &apos;3 stars&apos;&#10;ELSEIF [Driver Ratings] &lt;= 5 THEN &apos;4 stars&apos;&#10;ELSE &apos;5 stars&apos;&#10;END' />
      </column>
      <column caption='Distance Bucket' datatype='string' name='[Calculation_2401785159024645]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [distance] &lt;= 2 THEN &apos;0-2 Km&apos;&#10;ELSEIF [distance] &lt;= 4 THEN &apos;2-4 Km&apos;&#10;ELSEIF [distance] &lt;= 6 THEN &apos;4-6 Km&apos;&#10;ELSE &apos;More than 6 Km&apos;&#10;END' />
      </column>
      <column caption='Total Bookings' datatype='integer' name='[Calculation_2401785159888902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='Booking Value' datatype='real' name='[Calculation_2401785163255815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([price]) THEN 0&#10;ELSE [price] * IFNULL([surge_multiplier], 1)&#10;END' />
      </column>
      <column caption='Day (Number)' datatype='integer' name='[Day (copy)_2401785336954889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[day]' />
      </column>
      <column aggregation='None' datatype='integer' name='[Distance (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='-2' formula='[distance]' peg='0' size='0.35' />
      </column>
      <column caption='Hour (Category)' datatype='date' datatype-customized='true' default-format='n#,##0.00;-#,##0.00' name='[Hour (copy)_2401785335001096]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;HH&quot;, STR([hour]) )) ' />
      </column>
